classDiagram
    class User {
        +UUID id
        +String full_name
        +String email
        +String password_hash
        +String avatar_url
        +Boolean is_email_verified
        +Boolean is_onboarded
        +UserRole primary_role
        +String email_verify_token
        +String password_reset_token
        +DateTime created_at
    }

    class Company {
        +UUID id
        +String name
        +String logo_url
        +String website_url
        +String cal_booking_url
        +String cal_organizer_email
        +String domain
        +String industry
        +String location
        +DateTime created_at
    }

    class CompanyMembership {
        +UUID id
        +UUID user_id
        +UUID company_id
        +MembershipRole role
        +MembershipStatus status
        +String job_title
        +DateTime created_at
    }

    class RefreshToken {
        +UUID id
        +UUID user_id
        +String token
        +String jti
        +DateTime expires_at
        +DateTime created_at
    }

    User --> CompanyMembership : has
    Company --> CompanyMembership : has
    User --> RefreshToken : has
