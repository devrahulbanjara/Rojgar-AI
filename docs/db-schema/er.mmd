%% Subsystem 1 - Authentication, User and Company Management
erDiagram
    companies {
        UUID id PK
        STRING name
        STRING cal_organizer_email UK
        STRING domain UK
    }
    users {
        UUID id PK
        STRING email UK
        BOOLEAN is_email_verified
        BOOLEAN is_onboarded
        BOOLEAN is_deleted
        ENUM primary_role
    }
    company_memberships {
        UUID id PK
        UUID user_id FK
        UUID company_id FK
        ENUM role
        ENUM status
    }
    oauth_accounts {
        UUID id PK
        UUID user_id FK
    }
    refresh_tokens {
        UUID id PK
        UUID user_id FK
        STRING jti UK
        DATETIME expires_at
    }
    companies ||--|{ company_memberships : "company_id"
    users ||--|{ company_memberships : "user_id"
    users ||--|{ oauth_accounts : "user_id"
    users ||--|{ refresh_tokens : "user_id"

%% Subsystem 2 - Shortlisting (Jobs and Applications)
erDiagram
    job_sync_events {
        UUID id PK
        ENUM action
        ENUM status
    }
    jobs {
        UUID id PK
        UUID company_id FK
        UUID posted_by FK
        STRING title
        ENUM location_type
        ENUM status
        BOOLEAN auto_shortlist
        ENUM shortlist_status
        INTEGER shortlist_threshold
        DATETIME expires_at
    }
    applications {
        UUID id PK
        UUID job_id FK
        UUID user_id FK
        UUID resume_id FK
        INTEGER score
        FLOAT ml_bouncer_score
        ENUM status
    }
    jobs ||--|{ applications : "job_id"

%% Subsystem 3 - Recruiter Chat
erDiagram
    recruiter_chat_sessions {
        UUID id PK
        UUID recruiter_id FK
        UUID company_id FK
        STRING thread_id UK
        TEXT title
    }
    recruiter_preferences {
        UUID id PK
        UUID user_id FK
    }

