        UUID user_id FK
        BOOLEAN is_open_to_work
    }
    resume_import_tasks {
        UUID id PK
        UUID user_id FK
        STRING status
    }
    resumes {
        UUID id PK
        UUID user_id FK
    }
    profile_educations {
        UUID id PK
        UUID profile_id FK
    }
    profile_experiences {
        UUID id PK
        UUID profile_id FK
        STRING title
    }
    profile_skills {
        UUID id PK
        UUID profile_id FK
    }
    resume_educations {
        UUID id PK
        UUID resume_id FK
    }
    resume_experiences {
        UUID id PK
        UUID resume_id FK
        STRING title
    }
    resume_skills {
        UUID id PK
        UUID resume_id FK
    }
    profiles ||--|{ profile_educations : "profile_id"
    profiles ||--|{ profile_experiences : "profile_id"
    profiles ||--|{ profile_skills : "profile_id"
    resumes ||--|{ resume_educations : "resume_id"
    resumes ||--|{ resume_experiences : "resume_id"
    resumes ||--|{ resume_skills : "resume_id"

%% Subsystem 5 - Interview Recording and Evaluation
erDiagram
    job_evaluation_schemas {
        UUID id PK
        UUID job_id FK
        INTEGER version
        FLOAT human_weight
        FLOAT llm_weight
    }
    candidate_evaluation_scores {
        UUID id PK
        UUID application_id FK
        UUID job_id FK
        UUID schema_id FK
        STRING evaluator_type
        FLOAT weighted_total
        UUID submitted_by_user_id FK
    }
    interview_recordings {
        UUID id PK
        UUID application_id FK
        TEXT transcript
        ENUM status
    }
    job_evaluation_schemas ||--o{ candidate_evaluation_scores : "schema_id"

%% Subsystem 6 - AI Job Drafting
erDiagram
    job_ai_drafts {
        UUID id PK
        UUID recruiter_id FK
        UUID company_id FK
        STRING thread_id UK
        STRING status
        STRING mode
        UUID committed_job_id FK
    }

%% Subsystem 7 - Outreach and Interview Scheduling
erDiagram
    email_drafts {
        UUID id PK
        UUID application_id FK
        UUID generated_by_user_id FK
        BOOLEAN is_approved
        UUID approved_by_user_id FK
        BOOLEAN is_sent
        UUID sent_by_user_id FK
        BOOLEAN is_discarded
        UUID discarded_by_user_id FK
    }
    interviews {
        UUID id PK
        UUID application_id FK
        STRING cal_booking_uid UK
        DATETIME start_time
        DATETIME end_time
        STRING title
    }

%% Cross-cutting - Notifications, Audit, Activity
erDiagram
    audit_logs {
        UUID id PK
    }
    activity_events {
        UUID id PK
        UUID user_id FK
        UUID company_id FK
        UUID application_id FK
        UUID job_id FK
        UUID interview_id FK
        UUID draft_id FK
        UUID actor_user_id FK
        STRING title
    }
    notifications {
        UUID id PK
        UUID user_id FK
        UUID company_id FK
        UUID activity_event_id FK
        STRING title
    }
    activity_events ||--o{ notifications : "activity_event_id"

