{
  "name": "convexhire-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "// --- linting ---": "─────────────────────────────────────────",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "// --- scss ---": "use when SCSS feels messy",
    "stylelint": "stylelint **/*.scss",
    "stylelint:fix": "stylelint **/*.scss --fix",
    "// --- formatting ---": "run before committing / task complete",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// --- fix-all ---": "full clean: scss → lint → format (before commit)",
    "fix-all": "pnpm type-check && pnpm stylelint:fix && pnpm lint:fix && pnpm format",
    "// --- e2e ---": "Playwright — boots docker test stack + migrations + backend (uv) + frontend automatically",
    "e2e": "node e2e/run-e2e.mjs",
    "e2e:ui": "node e2e/run-e2e.mjs --ui",
    "e2e:keep": "KEEP_DOCKER=1 node e2e/run-e2e.mjs",
    "e2e:no-backend": "SKIP_BACKEND=1 SKIP_DOCKER=1 SKIP_MIGRATIONS=1 node e2e/run-e2e.mjs",
    "e2e:no-docker": "SKIP_DOCKER=1 SKIP_MIGRATIONS=1 node e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/html2pdf.js": "^0.10.0",
    "gsap": "^3.14.2",
    "html2pdf.js": "^0.14.0",
    "lenis": "^1.3.18-dev.0",
    "libphonenumber-js": "^1.13.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.6",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swiper": "^12.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.1",
    "sass": "^1.97.3",
    "stylelint": "^17.4.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5"
  }
}
