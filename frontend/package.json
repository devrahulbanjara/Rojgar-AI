{
  "name": "rojgar-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "// --- linting ---": "─────────────────────────────────────────",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "// --- scss ---": "use when SCSS feels messy",
    "stylelint": "stylelint **/*.scss",
    "stylelint:fix": "stylelint **/*.scss --fix",
    "// --- formatting ---": "run before committing / task complete",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// --- fix-all ---": "full clean: scss → lint → format (before commit)",
    "fix-all": "pnpm type-check && pnpm stylelint:fix && pnpm lint:fix && pnpm format",
    "// --- e2e ---": "Playwright — boots docker test stack + migrations + backend (uv) + frontend automatically",
    "e2e": "node e2e/run-e2e.mjs",
    "e2e:ui": "node e2e/run-e2e.mjs --ui",
    "e2e:keep": "KEEP_DOCKER=1 node e2e/run-e2e.mjs",
    "e2e:no-backend": "SKIP_BACKEND=1 SKIP_DOCKER=1 SKIP_MIGRATIONS=1 node e2e/run-e2e.mjs",
    "e2e:no-docker": "SKIP_DOCKER=1 SKIP_MIGRATIONS=1 node e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@hookform/resolvers": "5.9.1",
    "@phosphor-icons/react": "2.1.10",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.18-dev.0",
    "libphonenumber-js": "^1.13.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-redux": "^9.2.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "8.5.28",
    "prettier": "3.8.1",
    "sass": "^1.97.3",
    "stylelint": "^17.4.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
