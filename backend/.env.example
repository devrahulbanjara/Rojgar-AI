# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# App Config
# dev | test | prod. The app defaults to prod when unset, so keep this explicit
# for local development (dev enables /docs and non-Secure cookies over http).
environment=dev
# Reverse proxies in front of the API that append to X-Forwarded-For
# (e.g. 1 on Render). 0 = use the socket peer address.
TRUSTED_PROXY_HOPS=0
APP_VERSION=1.0.0

# Qdrant Vector DB
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM=your_email@gmail.com

# AI / LLM Keys
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
TAVILY_API_KEY=your_tavily_api_key

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT="Rojgar AI"
# Traces would otherwise contain full resumes, candidate names and chat history.
# Keep inputs/outputs hidden in any environment with real candidate data.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Database (Supabase / PostgreSQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=postgres
# Connections per API worker (kept open + extra under load). Keep
# workers x (size + overflow) below your Postgres connection limit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name
# Uploads go to local disk unless ENVIRONMENT=prod (or STORAGE_BACKEND=s3).
STORAGE_BACKEND=

# Application review (rolling, one per application)
# Provider: groq (default) | bedrock | fake (deterministic, tests/offline)
REVIEW_PROVIDER=groq
REVIEW_MODEL=openai/gpt-oss-120b
REVIEW_CHEAP_MODEL=openai/gpt-oss-20b
REVIEW_MAX_ATTEMPTS=4
# Bedrock alternative (REVIEW_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID_SHORTLISTING=your_bedrock_access_key_id
AWS_SECRET_ACCESS_KEY_SHORTLISTING=your_bedrock_secret_access_key
REVIEW_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# SMS: real messages only in prod with SMS_PROVIDER=sparrow (else logged)
SMS_PROVIDER=console
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=RojgarAI
SMS_LANGUAGE=ne

# Redis Caching (Upstash or Redis Cloud)
REDIS_URL=rediss://default:your_password@your-upstash-url.upstash.io:6379
REDIS_ENABLED=true


# Public apply links (no-account applications)
# Shown to candidates in emails; rename the product here.
PRODUCT_NAME=Rojgar AI
# Cloudflare Turnstile secret; when set, /public/jobs/{slug}/applications requires a valid token.
TURNSTILE_SECRET=
PUBLIC_STATUS_TOKEN_DAYS=180
MAGIC_LINK_TTL_MINUTES=15
