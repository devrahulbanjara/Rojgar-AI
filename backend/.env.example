# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT
SECRET_KEY=your_secret_key_here

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# App Config
# dev | test | prod. The app defaults to prod when unset, so keep this explicit
# for local development (dev enables /docs and non-Secure cookies over http).
environment=dev
# Reverse proxies in front of the API that append to X-Forwarded-For
# (e.g. 1 on Render). 0 = use the socket peer address.
TRUSTED_PROXY_HOPS=0

# Qdrant Vector DB
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM=your_email@gmail.com

# AI / LLM Keys
GROQ_API_KEY=your_groq_api_key
# Optional fallback: when set, Gemini answers whenever Groq fails or is rate limited.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=your_tavily_api_key

# Database (Supabase / PostgreSQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=postgres
# Connections per API worker (kept open + extra under load). Keep
# workers x (size + overflow) below your Postgres connection limit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# File storage: local disk unless ENVIRONMENT=prod or STORAGE_BACKEND=cloudinary.
CLOUDINARY_URL=
STORAGE_BACKEND=

# Application review (rolling, one per application)
# Provider: groq (default) | fake (deterministic, tests/offline)
REVIEW_PROVIDER=groq

# SMS costs money and is off: sign-in uses Google or email, applicants hear
# back by email. Real texts need SMS_ENABLED=true, environment=prod,
# SMS_PROVIDER=sparrow and a token (dev/test only log them).
SMS_ENABLED=false
SMS_PROVIDER=console
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=RojgarAI

# Local AI models (embeddings + BM25, downloaded once from Hugging Face)
MODEL_CACHE_DIR=~/.cache/fastembed
EMBEDDING_THREADS=2

# Redis Caching (Upstash or Redis Cloud)
REDIS_URL=rediss://default:your_password@your-upstash-url.upstash.io:6379
REDIS_ENABLED=true

# Public apply links (no-account applications)
# Cloudflare Turnstile secret; when set, /public/jobs/{slug}/applications requires a valid token.
TURNSTILE_SECRET=
