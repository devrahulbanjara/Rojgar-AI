# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# JWT
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# App Config
# dev | test | prod. The app defaults to prod when unset, so keep this explicit
# for local development (dev enables /docs and non-Secure cookies over http).
environment=dev
# Reverse proxies in front of the API that append to X-Forwarded-For
# (e.g. 1 on Render). 0 = use the socket peer address.
TRUSTED_PROXY_HOPS=0
APP_VERSION=1.0.0

# Qdrant Vector DB
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM=your_email@gmail.com

# AI / LLM Keys
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_api_key
TAVILY_API_KEY=your_tavily_api_key

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT="ConvexHire"

# Database (Supabase / PostgreSQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=postgres

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID_SHORTLISTING=your_shortlisting_aws_access_key_id
AWS_SECRET_ACCESS_KEY_SHORTLISTING=your_shortlisting_aws_secret_access_key
AWS_BEDROCK_SHORTLISTING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_BEDROCK_SHORTLISTING_TEMPERATURE=0.0
AWS_BEDROCK_SHORTLISTING_MAX_TOKENS=1200
S3_BUCKET_NAME=your_s3_bucket_name

# Shortlisting Agent
SHORTLISTING_REFLECTION_MAX_ITERATIONS=2
SHORTLISTING_WEB_SEARCH_MAX_RESULTS=3

# Redis Caching (Upstash or Redis Cloud)
REDIS_URL=rediss://default:your_password@your-upstash-url.upstash.io:6379
REDIS_ENABLED=true

# Cal.com booking webhook: the secret configured on the Cal webhook
# (required in prod; requests are verified via X-Cal-Signature-256)
CAL_WEBHOOK_SECRET=
