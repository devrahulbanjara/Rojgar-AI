LIST_FIELDS = {
    "responsibilities",
    "requirements",
    "preferred_qualifications",
    "benefits",
}
INT_FIELDS = {"salary_min", "salary_max"}
STRING_FIELDS = {"title", "location", "currency", "overview", "expires_at"}
