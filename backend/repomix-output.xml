    )


async def _clarify_candidate_selection_impl(
    application_id: str,
    candidate_name: str,
    job_title: str,
    question: str,
    company_id: uuid.UUID,
) -> ToolResultEnvelope:
    """Security check: confirm the application belongs to a company job before emitting clarification."""
    try:
        parsed_app_id = uuid.UUID(application_id)
    except ValueError:
