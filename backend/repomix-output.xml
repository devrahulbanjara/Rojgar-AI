    """Company/recruiter updates the application status."""

    status: ApplicationStatus = Field(
        ...,
        description="New status for the application",
    )


# ---------------------------------------------------------------------------
# Responses
# ---------------------------------------------------------------------------


class ApplicationResponse(BaseSchema):
    id: UUID
    job_id: UUID
    user_id: UUID
