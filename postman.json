{
  "info": {
    "name": "ConvexHire MVP API Collection",
    "_postman_id": "job-board-api-collection",
    "description": "Complete API collection for the Job Board platform. Includes Auth, Companies, Jobs, Applications, Profiles, Resumes, and Dashboards.\n\n## Setup\n1. Set `base_url` variable (e.g. `http://localhost:8000`)\n2. Use **POST /auth/signup** → **POST /auth/verify-email** → **POST /auth/login**\n3. The `access_token` is automatically saved after login via the test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Base URL of the API server"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token — auto-populated after login"
    },
    {
      "key": "setup_token",
      "value": "",
      "type": "string",
      "description": "Setup token returned after signup (recruiter/admin flows)"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string",
      "description": "UUID of a job — auto-populated after job creation"
    },
    {
      "key": "resume_id",
      "value": "",
      "type": "string",
      "description": "UUID of a resume — auto-populated after resume creation"
    },
    {
      "key": "application_id",
      "value": "",
      "type": "string",
      "description": "UUID of an application — auto-populated after applying"
    },
    {
      "key": "membership_id",
      "value": "",
      "type": "string",
      "description": "UUID of a company membership"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string",
      "description": "UUID of a user"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Authentication flows: local signup/login, email verification, password reset, token refresh, and Google OAuth.",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"primary_role\": \"candidate\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Stage 1 of local signup. Validates credentials and sends a verification email.\n\n`primary_role` options: `candidate`, `recruiter`, `recruiter_admin`\n\nIf the role is `recruiter` or `recruiter_admin`, a `setup_token` is returned in the response to continue the company setup flow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.setup_token) {",
                  "    pm.collectionVariables.set('setup_token', res.data.setup_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<verification_token_from_email>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Completes account creation after email verification. Paste the token received in the verification email."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"remember_me\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Authenticate with email and password. Returns access and refresh tokens.\n\nThe `access_token` is automatically saved to the collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.tokens && res.data.tokens.access_token) {",
                  "    pm.collectionVariables.set('access_token', res.data.tokens.access_token);",
                  "}",
                  "if (res.data && res.data.user && res.data.user.id) {",
                  "    pm.collectionVariables.set('user_id', res.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Refresh expired access token using the `refresh_token` httpOnly cookie automatically sent by the browser. Returns a new access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('access_token', res.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Invalidates the refresh token and clears authentication cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('access_token', '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the authenticated user's profile information. Requires Bearer token."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Initiates the password reset flow. Sends a reset link to the provided email if the account exists."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset_token_from_email>\",\n  \"new_password\": \"NewStrongPass456!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Completes the password reset using the token from the reset email link."
          },
          "response": []
        },
        {
          "name": "Google OAuth — Initiate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": ["{{base_url}}"],
              "path": ["auth", "google"]
            },
            "description": "Redirects to Google's OAuth consent screen. Open this URL in a browser — it will set an `oauth_state` cookie and redirect to Google."
          },
          "response": []
        },
        {
          "name": "Google OAuth — Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google/callback?code=<auth_code>&state=<csrf_state>",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "callback"],
              "query": [
                { "key": "code", "value": "<auth_code>", "description": "Authorization code from Google" },
                { "key": "state", "value": "<csrf_state>", "description": "CSRF state token echoed back by Google" }
              ]
            },
            "description": "Handles Google OAuth callback. Existing users are logged in; new users receive a `signup_token` to complete registration via `/auth/google/register`."
          },
          "response": []
        },
        {
          "name": "Google OAuth — Complete Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/google/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signup_token\": \"<signup_token_from_google_callback>\",\n  \"primary_role\": \"candidate\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Two-phase Google signup: consumes the `signup_token` from the OAuth callback and creates the account. `primary_role`: `candidate`, `recruiter`, or `recruiter_admin`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.tokens && res.data.tokens.access_token) {",
                  "    pm.collectionVariables.set('access_token', res.data.tokens.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "🏢 Companies",
      "description": "Company registration, recruiter join requests, and company admin management of recruiter memberships.",
      "item": [
        {
          "name": "Register Company (Admin Signup Step 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/companies/register",
              "host": ["{{base_url}}"],
              "path": ["companies", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"setup_token\": \"{{setup_token}}\",\n  \"company_name\": \"Acme Corp\",\n  \"industry\": \"Technology\",\n  \"company_size\": \"51-200\",\n  \"website\": \"https://acme.com\",\n  \"location\": \"San Francisco, CA\",\n  \"description\": \"We build cool things.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Stage 2 of the `recruiter_admin` signup flow. Bundles company details and resends the verification email. Requires the `setup_token` from Stage 1 (signup)."
          },
          "response": []
        },
        {
          "name": "Request to Join Company (Recruiter Signup Step 2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/companies/join-request",
              "host": ["{{base_url}}"],
              "path": ["companies", "join-request"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"setup_token\": \"{{setup_token}}\",\n  \"company_name\": \"Acme Corp\",\n  \"message\": \"I'd love to join and help recruit top talent.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Stage 2 of the `recruiter` signup flow. Bundles join request details and resends the verification email. Requires the `setup_token` from Stage 1."
          },
          "response": []
        },
        {
          "name": "List Company Recruiters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/companies/me/recruiters",
              "host": ["{{base_url}}"],
              "path": ["companies", "me", "recruiters"]
            },
            "description": "List all recruiter members of the authenticated company admin's company. **Requires `recruiter_admin` role.**"
          },
          "response": []
        },
        {
          "name": "Update Recruiter Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/companies/me/recruiters/{{membership_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["companies", "me", "recruiters", "{{membership_id}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Approve or reject a recruiter's join request. **Requires `recruiter_admin` role.**\n\n`status` options: `active` (approve), `rejected` (reject)"
          },
          "response": []
        },
        {
          "name": "Remove Recruiter",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/companies/me/recruiters/{{membership_id}}",
              "host": ["{{base_url}}"],
              "path": ["companies", "me", "recruiters", "{{membership_id}}"]
            },
            "description": "Permanently removes a recruiter from the company. **Requires `recruiter_admin` role.**"
          },
          "response": []
        }
      ]
    },
    {
      "name": "💼 Jobs",
      "description": "Create, search, list, update, and delete job postings.",
      "item": [
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/",
              "host": ["{{base_url}}"],
              "path": ["jobs", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Backend Engineer\",\n  \"location\": \"New York, NY\",\n  \"location_type\": \"hybrid\",\n  \"salary_min\": 120000,\n  \"salary_max\": 160000,\n  \"currency\": \"USD\",\n  \"status\": \"published\",\n  \"overview\": \"Join our growing engineering team to build scalable backend systems.\",\n  \"responsibilities\": [\n    \"Design and implement REST APIs\",\n    \"Review code and mentor junior engineers\"\n  ],\n  \"requirements\": [\n    \"5+ years Python experience\",\n    \"Experience with FastAPI or Django\"\n  ],\n  \"preferred_qualifications\": [\n    \"Experience with PostgreSQL and Redis\"\n  ],\n  \"benefits\": [\n    \"Competitive salary\",\n    \"Health insurance\",\n    \"Remote-friendly\"\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Creates a new job posting under the authenticated user's company. **Requires recruiter or recruiter_admin role.**\n\n`location_type`: `remote`, `onsite`, `hybrid`\n`status`: `draft`, `published`, `closed`"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('job_id', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "Search Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs/?q=engineer&location=New York&location_type=hybrid&page=1&size=20",
              "host": ["{{base_url}}"],
              "path": ["jobs", ""],
              "query": [
                { "key": "q", "value": "engineer", "description": "Keyword search on job title" },
                { "key": "location", "value": "New York", "description": "Filter by location string" },
                { "key": "location_type", "value": "hybrid", "description": "remote | onsite | hybrid" },
                { "key": "page", "value": "1", "description": "Page number (default: 1)" },
                { "key": "size", "value": "20", "description": "Items per page (1–100, default: 20)" }
              ]
            },
            "description": "Publicly accessible. Search and filter open job listings. All query params are optional."
          },
          "response": []
        },
        {
          "name": "List My Company's Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs/company/me",
              "host": ["{{base_url}}"],
              "path": ["jobs", "company", "me"]
            },
            "description": "Lists all jobs posted by the current user's company (all statuses). **Requires authentication.**"
          },
          "response": []
        },
        {
          "name": "Get Job Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Retrieve full job details including all description fields. Publicly accessible."
          },
          "response": []
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lead Backend Engineer\",\n  \"status\": \"published\",\n  \"salary_min\": 130000,\n  \"salary_max\": 175000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Partial update of a job posting. Only the fields provided will be updated. **Requires ownership** (the recruiter/admin who posted it)."
          },
          "response": []
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Permanently deletes a job posting. **Requires ownership.**"
          },
          "response": []
        }
      ]
    },
    {
      "name": "📋 Applications",
      "description": "Submit job applications and manage application status for candidates and recruiters.",
      "item": [
        {
          "name": "Apply to Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/applications/",
              "host": ["{{base_url}}"],
              "path": ["applications", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"resume_id\": \"{{resume_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Submit an application for a job. **Requires `candidate` role.**\n\nA `resume_id` must be provided. If no resume exists, create one first via `POST /resumes/`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('application_id', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "List My Applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/applications/me?page=1&size=20",
              "host": ["{{base_url}}"],
              "path": ["applications", "me"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Lists all applications submitted by the authenticated candidate. **Requires `candidate` role.**"
          },
          "response": []
        },
        {
          "name": "List Applications for a Job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/applications/job/{{job_id}}?page=1&size=20",
              "host": ["{{base_url}}"],
              "path": ["applications", "job", "{{job_id}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Lists all applications for a specific job. **Requires recruiter or recruiter_admin role.**"
          },
          "response": []
        },
        {
          "name": "Get Application Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}",
              "host": ["{{base_url}}"],
              "path": ["applications", "{{application_id}}"]
            },
            "description": "Retrieve full details of a specific application including the attached resume. **Requires authentication.** Candidates can only view their own applications."
          },
          "response": []
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/applications/{{application_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["applications", "{{application_id}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"reviewing\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Move an application through the hiring pipeline. **Requires recruiter or recruiter_admin role.**\n\nCommon `status` values: `pending`, `reviewing`, `shortlisted`, `rejected`, `hired`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "👤 Profiles",
      "description": "Manage candidate profiles — the canonical source of truth forked into resumes.",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profiles/me",
              "host": ["{{base_url}}"],
              "path": ["profiles", "me"]
            },
            "description": "Get the authenticated candidate's profile. Creates an empty profile if one doesn't exist yet. **Requires `candidate` role.**"
          },
          "response": []
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/profiles/me",
              "host": ["{{base_url}}"],
              "path": ["profiles", "me"]
            },
